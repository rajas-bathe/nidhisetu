# SIH26265 backend environment (never commit real .env files)
# ------------------------------------------------------------------
# DATABASE_URL  <<-- THE ONE VARIABLE YOU MUST FILL IN
# Use the PUBLIC (externally accessible) PostgreSQL connection string from
# Railway -> your database service -> "Connect" (Public tab). A Railway
# PRIVATE-network hostname will NOT work from a laptop.
# Example shape:
#   postgresql://postgres:AVNS_xxxxxxxx@<proxyhost>.rlwy.net:<port>/railway
#
# While you have not filled it in yet, you can run the whole stack against the
# bundled LOCAL development database instead (no Docker):
#   npm run local:db          (starts PostgreSQL on localhost:5433)
#   npm run db:apply          (applies migrations)
#   npm run db:seed -- --yes  (demo data, opt-in)
DATABASE_URL="postgresql://fdr_portal:fdr_dev_password@localhost:5433/fdr_portal?schema=public"

# Dedicated TEST database for integration tests (never the dev DB above;
# test truncation is refused unless the name contains "test").
TEST_DATABASE_URL="postgresql://fdr_portal:fdr_dev_password@localhost:5433/fdr_portal_test?schema=public"
# Only for environments that expose the test database via DATABASE_URL itself.
TEST_USES_DATABASE_URL="false"

# HTTP
PORT=4000
# Comma-separated list of browser origins allowed to call mutating endpoints.
# 5174/5175 cover Vite's auto-incremented ports when 5173 is already taken.
# PRODUCTION: override with your real frontend origin(s), e.g. https://portal.example.in
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

# Session cookie. In production behind HTTPS, set COOKIE_SECURE=true.
COOKIE_SECURE="false"
SESSION_TTL_DAYS=7

# Rate limiting for the login endpoint (per instance; see docs/deployment.md).
LOGIN_RATE_LIMIT_WINDOW_MINUTES=10
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=8

# Business timezone used to derive "today" (calendar date boundaries).
BUSINESS_TIMEZONE="Asia/Kolkata"

# SAMPLE demonstration policy values - NOT official AICTE regulations.
# Days before maturity at which instruments are flagged "approaching".
SAMPLE_APPROACHING_MATURITY_DAYS=30
# Reminder task stages (days before maturity) produced by the worker.
SAMPLE_REMINDER_THRESHOLDS_DAYS="30,14,7"

# ---------------- Document storage ----------------
# STORAGE_DRIVER=local  -> private directory below (development default)
# STORAGE_DRIVER=s3     -> real S3-compatible bucket for production; requires
#                          the S3_* settings. The backend NEVER substitutes
#                          temporary storage for an unconfigured bucket.
STORAGE_DRIVER="local"
# Local driver directory (relative paths resolve from the repo root; default:
# <repo>/storage/local-dev; stays git-ignored, outside frontend/public).
LOCAL_STORAGE_DIR=""
# Upload limit in MB.
MAX_UPLOAD_MB=10

# S3 driver settings (leave empty until you provision a bucket).
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Optional custom endpoint for S3-compatible providers (R2/MinIO/Wasabi).
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="true"

# Worker cadence (minutes) for `npm run worker` watch mode.
JOB_INTERVAL_MINUTES=60

# Logging: pino level (debug|info|warn|error).
LOG_LEVEL=info

# Seed safety. Demo seeding is OPT-IN: run `npm run db:seed -- --yes`.
# Remote-host seeding additionally requires SEED_ALLOW_REMOTE=true (protects
# shared databases); NODE_ENV=production requires SEED_ALLOW_PRODUCTION=true.
SEED_ALLOW_DEMO="false"
SEED_ALLOW_REMOTE="false"
SEED_ALLOW_PRODUCTION="false"
# Demo credentials (defaults below suit local development only; override everywhere).
# NOTE: values are double-quoted on purpose - dotenv treats an unquoted "#"
# as the start of an inline comment (Demo#College1 would parse as "Demo").
DEMO_COLLEGE_A_EMAIL="college.lotus@demo.fdrportal.local"
DEMO_COLLEGE_A_PASSWORD="Demo#College1"
DEMO_COLLEGE_B_EMAIL="college.shivalik@demo.fdrportal.local"
DEMO_COLLEGE_B_PASSWORD="Demo#College2"
DEMO_REVIEW_OFFICER_EMAIL="officer.review@demo.fdrportal.local"
DEMO_REVIEW_OFFICER_PASSWORD="Demo#Officer"
DEMO_APPROVER_EMAIL="authority.approve@demo.fdrportal.local"
DEMO_APPROVER_PASSWORD="Demo#Authority"
